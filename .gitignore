# =========================================================
# BookSpace: monorepo (backend/ = Spring Boot, frontend/ = Vite + React)
# One .gitignore for the whole repo; delete the generated
# backend/.gitignore and frontend/.gitignore.
# =========================================================

# ---------- Java / Maven ----------
target/
*.class
# Archives are build outputs; nothing in this repo should be a committed archive
*.jar
*.war
*.zip
*.tar.gz
# Maven Wrapper: keep mvnw, mvnw.cmd and .mvn/wrapper/maven-wrapper.properties,
# ignore only the downloaded binary
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
# JVM crash logs
hs_err_pid*
replay_pid*
# Generated by Spring Initializr
HELP.md

# ---------- Node / Vite (frontend) ----------
# Keep package-lock.json committed: `npm ci` in CI needs it
node_modules/
dist/
coverage/
.eslintcache
vite.config.js.timestamp-*
npm-debug.log*

# ---------- Secrets ----------
# Real values live only on your machine / in the hosting dashboard
.env
.env.*
!.env.example

# ---------- Logs ----------
logs/
*.log

# ---------- IDE ----------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
# VS Code
.vscode/
# Eclipse / Spring Tools
.project
.classpath
.settings/
.factorypath
.sts4-cache/

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini